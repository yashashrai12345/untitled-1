{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/public/patterns", "destination": "/api/public/patterns" },
    { "source": "/api/publish", "destination": "/api/publish" },
    { "source": "/api/delete", "destination": "/api/delete" },
    { "source": "/api/reorder", "destination": "/api/reorder" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
